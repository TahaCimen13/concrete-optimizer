# ── Secrets (NEVER commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example

# ── Python / backend ─────────────────────────────────────────────────────────
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
# Model trained at build time:
backend/models/
# Dataset: ignore the downloaded .xls but commit the small CSV so the Docker
# build needs no network (more reliable than downloading from UCI at build).
backend/data/*
!backend/data/concrete.csv
# Per-user uploaded datasets/models (runtime state):
backend/storage/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/next-env.d.ts

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
*.log
